    "briefing": {
      "eyebrow": "Editorial Briefing",
      "title": "Not a pile of tools — one chain from theory to evidence",
      "lead": "Every section is its own page: jump straight to a workspace from the nav, stay on one topic, no hunting inside an endless scroll.",
      "aria": "Editorial briefing",
      "p1": {
        "label": "01 / Concept",
        "title": "First, build the language",
        "text": "One consistent set of symbols, assumptions and derivations ties CAPM, the SDF, Black–Scholes and OLS into a single language instead of scattered formulas."
      },
      "p2": {
        "label": "02 / Experiment",
        "title": "Then run the experiment",
        "text": "Parameters, data and stress scenarios live in one interface, so you can watch outputs move with assumptions and spot the sensitive variables fast."
      },
      "p3": {
        "label": "03 / Research",
        "title": "Finally, keep the output",
        "text": "Notebooks, templates, a paper index and reusable charts turn lectures, strategy prototypes and empirical homework into reproducible workflows."
      }
    },
