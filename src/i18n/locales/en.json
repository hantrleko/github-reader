    "stages": {
      "prob": {
        "title": "Probability, statistics & econometric method",
        "desc": "Random variables, distributions, LLN/CLT, then OLS, MLE, IV and GMM — the identification assumptions everything else rests on."
      },
      "micro": {
        "title": "Micro & macro foundations",
        "desc": "Preferences, constraints, equilibrium and strategic interaction; then growth, business cycles and policy rules at the aggregate level."
      },
      "fin": {
        "title": "Pricing fundamentals",
        "desc": "No-arbitrage, risk-neutral valuation, Black–Scholes and the implied-volatility surface — the shared language of financial models."
      },
      "ap": {
        "title": "Asset pricing & portfolio choice",
        "desc": "From the stochastic discount factor and CAPM-family models to factor construction, mean–variance optimisation and the efficient frontier."
      },
      "risk": {
        "title": "Risk measurement & fixed income",
        "desc": "VaR, expected shortfall, backtesting and capital rules; curve construction, duration and structured cash flows."
      },
      "adv": {
        "title": "Quant research & reproducible output",
        "desc": "Signal construction, the Qlib pipeline, out-of-sample evaluation and backtests you can hand over as a research artefact."
      }
    }
  },
